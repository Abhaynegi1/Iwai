{
  "name": "@iwai/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --offline",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline",
    "build": "echo \"Mobile builds use EAS Build. Run: eas build\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf .expo"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@iwai/api-client": "workspace:*",
    "@iwai/shared": "workspace:*",
    "@iwai/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "^18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.34.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@iwai/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.17",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "jest-expo": "~54.0.18",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "passWithNoTests": true,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  }
}
