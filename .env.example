# ============================================================
# IWAI — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env files that contain real secrets.
# ============================================================

# ─── Database ── packages/database, apps/api ───────────────
DATABASE_URL=

# ─── API Server ── apps/api ────────────────────────────────
NODE_ENV=development
PORT=3001
# Comma-separated allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# ─── Web App ── apps/web ───────────────────────────────────
# Server-side only
API_URL=http://localhost:3001
# Exposed to the browser (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Neon Auth ──────────────────────────────────────────────
NEON_AUTH_BASE_URL=https://<your-endpoint>.neonauth.<region>.aws.neon.tech/<dbname>/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://<your-endpoint>.neonauth.<region>.aws.neon.tech/<dbname>/auth
NEON_AUTH_COOKIE_SECRET=your-random-32-char-secret-string

# ─── Storage — Cloudflare R2 (future) ──────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ─── Background Jobs — Redis / BullMQ (future) ─────────────
# REDIS_URL=
