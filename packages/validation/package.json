    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@iwai/shared": "workspace:*",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@iwai/config": "workspace:*",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
